# ── Admin service environment file ────────────────────────────────────
# Place this at /etc/admin/admin.env on WS-VISION
# Copy and fill in your OAuth credentials from:
#   SoundCloud: https://soundcloud.com/you/apps
#   Google:     https://console.cloud.google.com/apis/credentials

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Production
# Kestrel is configured in Program.cs — listens on 8443 (HTTPS) + 8080 (HTTP redirect)
# Do NOT set ASPNETCORE_URLS; the code handles it via ConfigureKestrel

# Self-signed SSL certificate
UseHttps=true
# Hostnames/IPs for the cert's Subject Alternative Names (SANs)
# Include your Tailscale hostname + Tailscale IP so all devices can connect
CertSubjectNames__0=ws-vision
# CertSubjectNames__1=100.x.x.x  # Your Tailscale IP

# Allowed CORS origins (your static site + Tailscale addresses)
AllowedOrigins__0=https://akinevz.com
AllowedOrigins__1=https://ws-vision:8443

# Public site origin (for redirects)
SiteOrigin=https://akinevz.com

# SoundCloud OAuth credentials
SoundCloud__ClientId=YOUR_SOUNDCLOUD_CLIENT_ID
SoundCloud__ClientSecret=YOUR_SOUNDCLOUD_CLIENT_SECRET
# Use your Tailscale hostname or IP here
SoundCloud__RedirectUri=https://ws-vision:8443/auth/soundcloud/callback

# Google OAuth credentials
Google__ClientId=YOUR_GOOGLE_CLIENT_ID
Google__ClientSecret=YOUR_GOOGLE_CLIENT_SECRET
Google__RedirectUri=https://ws-vision:8443/auth/google/callback

# Data directory for landing.json etc.
DataDir=/opt/admin/data

# Optional: restrict to specific user IDs (empty = allow any authenticated user)
# AdminUsers__0=soundcloud:12345
# AdminUsers__1=google:1234567890