{
  "name": "website-xp-phone",
  "version": "2.2.9",
  "license": "GPL v2",
  "author": "Kirill <kine> Nevzorov <akinevz@outlook.com>",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=9.2.0",
    "clippy": "^1"
  },
  "scripts": {
    "dev": "vite",
    "refresh:content": "node ./scripts/refresh-content.mjs",
    "render": "echo 'https://render.com/'",
    "build": "vite build && npm run checksums && npm run render",
    "build:local": "npm run refresh:content && npm run check:all && npm run build && npm run dev && git add -A && git commit",
    "build:ready": "git add -A && npm run push",
    "push": "git push origin main",
    "preview": "vite preview --host 127.0.0.1 --port 8086",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "prettier --write \"src/**/*.{ts,tsx}\" && eslint ./src --ext .ts,.tsx",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check:audit": "npm audit --audit-level=low",
    "check:security": "npm run lint && npm run test",
    "check:all": "npm run check:security && npm run check:audit",
    "checksums": "node ./scripts/write-dist-checksums.mjs",
    "postinstall": "node ./scripts/ensure-xpcss.mjs"
  },
  "dependencies": {
    "eslint-plugin-react-refresh": "^0.5.7",
    "lightdni-jssas-toggle": "1.1.1",
    "postcss": "^8.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-toastify": "^11.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.1"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "protobufjs": ">=7.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "pagerts": "^2.0.2",
    "prettier": "^3.9.10",
    "zod": "^4.6.7"
  }
}
