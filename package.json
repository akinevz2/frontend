{
  "name": "website-xp-phone",
  "version": "1.5.1o",
  "license": "GPL v2",
  "author": "Kirill <kine> Nevzorov <akinevz@outlook.com>",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.2",
    "npm": ">=9.2.0",
    "clippy": "^1"
  },
  "scripts": {
    "dev": "vite",
    "refresh:content": "node ./scripts/refresh-content.mjs",
    "verify:policy": "node ./scripts/verify-policy.mjs",
    "render": "echo 'https://render.com/'",
    "build": "npm run refresh:content && vite build && npm run checksums && npm run render",
    "build:local": "npm run check:all && npm run build && npm run dev && git add -A && git commit",
    "build:ready": "git add -A && npm run push",
    "push": "git push origin main",
    "preview": "vite preview --host 127.0.0.1 --port 8086",
    "lint": "npx --yes prettier --write \"src/**/*.{ts,tsx}\" && eslint ./src --ext .ts,.tsx",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check:audit": "npm audit --audit-level=low && npm run verify:policy",
    "check:security": "npm run lint && npm run test",
    "check:all": "npm run check:security && npm run check:audit",
    "checksums": "node ./scripts/write-dist-checksums.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "firebase": "^12.16.0",
    "globals": "^17.8.0",
    "lightdni-jssas-toggle": "1.0.5",
    "postcss": "^8.5.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "xp.css": "^0.2.6"
  },
  "overrides": {
    "lodash": "^4.17.21",
    "protobufjs": ">=7.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3"
  }
}