{
  "name": "website-xp-phone",
  "version": "2.7.0",
  "license": "GPL v2",
  "author": "Kirill <kine> Nevzorov <akinevz@outlook.com>",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=24.14.1",
    "npm": ">=9.2.0",
    "clippy": "^1"
  },
  "scripts": {
    "dev": "vite",
    "refresh:content": "node ./scripts/refresh-content.mjs",
    "refresh:soundcloud": "node ./scripts/refresh-soundcloud.mjs",
    "render": "echo 'https://render.com/'",
    "build": "vite build && npm run render",
    "build:gated": "npm run build && npm run checksums",
    "build:prep": "npm run refresh:content && npm run refresh:soundcloud && npm run check:all && npm run build:gated && npm run verify:policy",
    "build:local": "npm run build:prep && npm run dev",
    "build:ready": "git add -A && npm run push",
    "push": "git push origin main",
    "preview": "vite preview --host 127.0.0.1 --port 8086",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "prettier --write \"src/**/*.{ts,tsx}\" && eslint ./src --ext .ts,.tsx",
    "test": "node --import tsx --test",
    "test:watch": "node --test --watch",
    "check:audit": "npm_config_allow_scripts= npm audit --audit-level=low",
    "check:security": "npm run lint && npm run test",
    "check:all": "npm run check:security && npm run check:audit",
    "check:lockfile": "git diff --exit-code package-lock.json",
    "check:ci": "npm run check:lockfile && npm run build:gated && npm run verify:policy",
    "checksums": "node ./scripts/write-dist-checksums.mjs",
    "verify:policy": "node ./scripts/verify-policy.mjs",
    "postinstall": "node ./scripts/ensure-xpcss.mjs",
    "open": "npm run build:prep && firefox http://localhost:8086; npm run dev"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "lightdni-jssas-toggle": "1.1.1",
    "lowlight": "^3.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "react-toastify": "^11.2.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "typescript-eslint": "^8.72.0",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.6"
  },
  "overrides": {
    "node-forge": "^1.4.2",
    "lodash": "^4.17.21",
    "protobufjs": ">=7.6.5",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "pagerts": "^2.0.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
