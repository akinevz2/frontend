{
  "name": "website-xp-phone",
  "version": "1.5.10",
  "license": "CC-BY-NC-ND-4.0",
  "author": "Kirill <kine> Nevzorov <akinevz@outlook.com>",
  "type": "module",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "^26",
    "npm": "^11",
    "clippy": "1"
  },
  "scripts": {
    "dev": "vite",
    "refresh:content": "node ./scripts/refresh-content.mjs",
    "verify:policy": "node ./scripts/verify-policy.mjs",
    "render": "echo 'https://render.com/'",
    "build": "npm run refresh:content && npm run verify:policy && vite build && npm run checksums && npm run render",
    "build:local": "npm run build && git add -A && EDITOR=vi git commit && npm run build",
    "build:ready": "npm run push",
    "push": "git push origin main",
    "preview": "vite preview --host 127.0.0.1 --port 8086",
    "lint": "npx --yes prettier --write \"src/**/*.{ts,tsx}\" && eslint ./src --ext .ts,.tsx",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check:audit": "npm audit --audit-level=low",
    "security:check": "npm run lint && npm run test && npm run check:audit",
    "checksums": "node ./scripts/write-dist-checksums.mjs"
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "lightdni-jssas-toggle": "1.0.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-toastify": "^11.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "xp.css": "^0.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "pagerts": "^1.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.10"
  },
  "overrides": {
    "lodash": "^4.17.21"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true
  }
}