---
import Layout from "../components/Layout.astro";
import MenuBar from "../components/MenuBar.astro";
---

<Layout title="WoW Config - kine" description="Download World of Warcraft configuration files">
  <style>
    .wow-container {
      max-width: 600px;
      margin: 2rem auto;
      padding: 1rem;
    }

    .window {
      background: #ece9d8;
      border: 2px outset #dfdfdf;
      box-shadow: 2px 2px 5px rgba(0,0,0,0.2);
      padding: 1rem;
    }

    .title-bar {
      background: linear-gradient(180deg, #0a246a, #a6caf0);
      color: white;
      padding: 0.25rem 0.5rem;
      margin: -1rem -1rem 1rem;
      font-weight: bold;
    }

    .form-group {
      margin-bottom: 1rem;
    }

    label {
      display: block;
      margin-bottom: 0.5rem;
      font-weight: bold;
    }

    input[type="date"] {
      width: 300px;
      padding: 0.5rem;
      border: 2px inset var(--button-shadow);
      font-family: inherit;
      font-size: 1rem;
      color: #000;
      box-sizing: border-box;
    }

    input[type="text"] {
      width: 300px;
      padding: 0.5rem;
      border: 2px inset var(--button-shadow);
      font-family: inherit;
      font-size: 1rem;
      color: #000;
    }

    button {
      padding: 0.5rem 1.5rem;
      margin-right: 0.5rem;
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .error-message {
      color: #c00;
      margin-top: 0.5rem;
      font-weight: bold;
    }

    .success-message {
      color: #080;
      margin-top: 0.5rem;
      font-weight: bold;
    }

    .info-text {
      margin-bottom: 1rem;
      line-height: 1.5;
    }
  </style>

  <MenuBar />
  
  <div class="wow-container">
    <div class="window">
      <div class="title-bar">
        <span>WoW Configuration Download</span>
      </div>
      
      <div class="info-text">
        <p>To download the World of Warcraft configuration files, please enter your username and verify today's date.</p>
      </div>

      <form id="dateForm">
        <div class="form-group">
          <label for="usernameInput">Username:</label>
          <input 
            type="text" 
            id="usernameInput" 
            name="username" 
            placeholder="Enter username"
            required
          />
        </div>

        <div class="form-group">
          <label for="dateInput">Enter today's date:</label>
          <input 
            type="date" 
            id="dateInput" 
            name="date" 
            required
          />
        </div>

        <button type="submit">Verify & Download</button>
        <button type="button" id="cancelBtn">Cancel</button>

        <div id="message"></div>
      </form>
    </div>
  </div>

  <script>
    // Wait for xp.css to load
    document.addEventListener('DOMContentLoaded', () => {
      document.body.classList.add('styles-loaded');

      const form = document.getElementById('dateForm') as HTMLFormElement;
      const usernameInput = document.getElementById('usernameInput') as HTMLInputElement;
      const dateInput = document.getElementById('dateInput') as HTMLInputElement;
      const messageDiv = document.getElementById('message') as HTMLDivElement;
      const cancelBtn = document.getElementById('cancelBtn') as HTMLButtonElement;

      // Set max date to today
      const today = new Date().toISOString().split('T')[0];
      dateInput.max = today;

      cancelBtn.addEventListener('click', () => {
        window.location.href = '/';
      });

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const username = usernameInput.value.trim();
        const selectedDate = dateInput.value;
        const todayDate = new Date().toISOString().split('T')[0];

        messageDiv.innerHTML = '';

        if (!username) {
          messageDiv.innerHTML = '<p class="error-message">Please enter a username.</p>';
          return;
        }

        if (!selectedDate) {
          messageDiv.innerHTML = '<p class="error-message">Please enter a date.</p>';
          return;
        }

        if (username.toLowerCase() !== 'kine') {
          messageDiv.innerHTML = '<p class="error-message">Invalid username.</p>';
          return;
        }

        if (selectedDate === todayDate) {
          // Date is correct, trigger download
          messageDiv.innerHTML = '<p class="success-message">Date verified! Starting download...</p>';
          
          setTimeout(() => {
            const link = document.createElement('a');
            link.href = '/WoW_Config.zip';
            link.download = 'WoW_Config.zip';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            
            messageDiv.innerHTML = '<p class="success-message">Download started successfully!</p>';
          }, 500);
        } else {
          messageDiv.innerHTML = '<p class="error-message">Incorrect date. Please enter today\'s date.</p>';
        }
      });
    });
  </script>
</Layout>
