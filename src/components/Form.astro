---
import "../styles/main.css";

interface Props {
  page: string;
  buttonText?: string;
  modalTitle?: string;
}

const { page, buttonText = "View Page", modalTitle = "Page Viewer" } = Astro.props;
---

<main>
  <section class="page">
    <div class="window">
      <div class="title-bar">
        <div class="title-bar-text">Resume</div>
        <div class="title-bar-controls">
          <button aria-label="Minimize"></button>
          <button aria-label="Maximize"></button>
          <button aria-label="Close"></button>
        </div>
      </div>
      <div class="window-body">
        <button id="openIframeModal">{buttonText}</button>
        <button id="emailButton">Contact Emails</button>
      </div>
    </div>
  </section>
</main>

<!-- Iframe Modal -->
<div id="iframeModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 9999; align-items: center; justify-content: center;">
  <div class="window" style="width: 90vw; height: 90vh; max-width: 1200px; margin: auto;">
    <div class="title-bar">
      <div class="title-bar-text">{modalTitle}</div>
      <div class="title-bar-controls">
        <button aria-label="Close" id="iframeModalClose"></button>
      </div>
    </div>
    <div class="window-body" style="padding: 0; height: calc(100% - 2rem); overflow: hidden;">
      <iframe id="iframeContent" style="width: 100%; height: 100%; border: none;"></iframe>
    </div>
  </div>
</div>

<!-- Email Modal -->
<div id="emailModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 9999; align-items: center; justify-content: center;">
  <div class="window" style="max-width: 400px; margin: auto;">
    <div class="title-bar">
      <div class="title-bar-text">Contact Emails</div>
      <div class="title-bar-controls">
        <button aria-label="Close" id="emailModalClose"></button>
      </div>
    </div>
    <div class="window-body">
      <ul>
        <li><a href="mailto:akinevz@outlook.com">akinevz@outlook.com</a></li>
        <li><a href="mailto:akinevz@gmail.com">akinevz@gmail.com</a></li>
      </ul>
      <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
        <button id="emailModalOk">OK</button>
      </div>
    </div>
  </div>
</div>

<style>
  .window-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    padding: 2rem;
  }
  
  a {
    text-decoration: none;
  }

  #emailModal ul {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  #emailModal li {
    margin: 0.5rem 0;
  }
</style>

<script define:vars={{ page }}>
  function showEmailModal() {
    const modal = document.getElementById("emailModal");
    if (modal) {
      modal.style.display = "flex";
    }
  }

  function hideEmailModal() {
    const modal = document.getElementById("emailModal");
    if (modal) {
      modal.style.display = "none";
    }
  }

  function showIframeModal() {
    const modal = document.getElementById("iframeModal");
    const iframe = document.getElementById("iframeContent");
    if (modal && iframe) {
      iframe.src = page;
      modal.style.display = "flex";
    }
  }

  function hideIframeModal() {
    const modal = document.getElementById("iframeModal");
    const iframe = document.getElementById("iframeContent");
    if (modal && iframe) {
      modal.style.display = "none";
      iframe.src = ""; // Clear iframe content when closing
    }
  }

  document.addEventListener("DOMContentLoaded", function () {
    const emailButton = document.getElementById("emailButton");
    const emailModalClose = document.getElementById("emailModalClose");
    const emailModalOk = document.getElementById("emailModalOk");
    const openIframeModalButton = document.getElementById("openIframeModal");
    const iframeModalClose = document.getElementById("iframeModalClose");

    if (emailButton) {
      emailButton.addEventListener("click", showEmailModal);
    }

    if (emailModalClose) {
      emailModalClose.addEventListener("click", hideEmailModal);
    }

    if (emailModalOk) {
      emailModalOk.addEventListener("click", hideEmailModal);
    }

    if (openIframeModalButton) {
      openIframeModalButton.addEventListener("click", showIframeModal);
    }

    if (iframeModalClose) {
      iframeModalClose.addEventListener("click", hideIframeModal);
    }

    // Close iframe modal when clicking outside
    const iframeModal = document.getElementById("iframeModal");
    if (iframeModal) {
      iframeModal.addEventListener("click", function(e) {
        if (e.target === iframeModal) {
          hideIframeModal();
        }
      });
    }
  });
</script>
