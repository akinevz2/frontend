---
import contacts from "../contacts.json";
import { PageContent } from "./Page";
import { processContent } from "../windowing/server";
import type { SectionProps } from "../windowing";

const { processed, metadata } = processContent(contacts as SectionProps);
const pageMetadata = { sections: metadata };
---

<main>
    <PageContent client:only="react" sections={processed} pageMetadata={pageMetadata} />
</main>
