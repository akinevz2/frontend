---
import MenuBar from "./MenuBar.astro";
import "../styles/main.css";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "home of kine",
  description = "my cozy little personal website"
} = Astro.props;
---

<html>
  <head>
    <link rel="stylesheet" href="https://unpkg.com/xp.css@0.2.3/dist/98.css" id="theme-css" />
    <noscript><link rel="stylesheet" href="/loading.css" /></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:image" content="/avatar.png" />
    <title>{title}</title>
    <script is:inline>
      // Wait for DOM and 98.css to load before revealing content
      const checkStylesLoaded = () => {
        if (!document.body) return false;
        const themeCssLink = document.getElementById('theme-css');
        if (themeCssLink?.sheet) {
          document.body.classList.add('styles-loaded');
          return true;
        }
        return false;
      };

      // Wait for DOM to be ready
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          if (!checkStylesLoaded()) {
            const themeCssLink = document.getElementById('theme-css');
            if (themeCssLink) {
              themeCssLink.addEventListener('load', () => {
                document.body.classList.add('styles-loaded');
              });
            }
            setTimeout(() => {
              if (document.body && !document.body.classList.contains('styles-loaded')) {
                document.body.classList.add('styles-loaded');
              }
            }, 100);
          }
        });
      } else {
        // DOM already loaded
        if (!checkStylesLoaded()) {
          const themeCssLink = document.getElementById('theme-css');
          if (themeCssLink) {
            themeCssLink.addEventListener('load', () => {
              document.body.classList.add('styles-loaded');
            });
          }
          setTimeout(() => {
            if (document.body && !document.body.classList.contains('styles-loaded')) {
              document.body.classList.add('styles-loaded');
            }
          }, 100);
        }
      }
    </script>
  </head>
  <body>
    <MenuBar />
    <slot />
  </body>
</html>
