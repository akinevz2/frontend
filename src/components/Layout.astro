---
import MenuBar from "./MenuBar.astro";
import { SectionProvider } from "./SectionContext";
import "../styles/main.css";

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "home of kine",
  description = "my cozy little personal website"
} = Astro.props;
---

<html>
  <head>
    <link rel="stylesheet" href="https://unpkg.com/xp.css@0.2.3/dist/XP.css" id="xp-css" />
    <link rel="preload" href="/loading.css" as="style" />
    <noscript><link rel="stylesheet" href="/loading.css" /></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:image" content="/avatar.png" />
    <title>{title}</title>
    <script>
      // Wait for XP.css to load before revealing content
      document.addEventListener('DOMContentLoaded', () => {
        const xpCssLink = document.getElementById('xp-css');
        if (xpCssLink) {
          xpCssLink.addEventListener('load', () => {
            document.body.classList.add('styles-loaded');
          });
          // In case it's already loaded
          if (xpCssLink.sheet) {
            document.body.classList.add('styles-loaded');
          }
        }
      });
    </script>
  </head>
  <body>
    <MenuBar />
    <slot />
  </body>
</html>
