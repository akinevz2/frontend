---
import { generateMenuItems, type MenuItem } from "../utils/menuItems";
import { MenuBarWithContext } from "./MenuBarWithContext";

interface Props {
  links?: { label: string; href: string }[];
  additionalLinks?: MenuItem[];
}

const { links, additionalLinks = [] } = Astro.props;

// Auto-discover pages if links not provided
let menuItems: MenuItem[];
if (links) {
  menuItems = links.map(link => ({ label: link.label, href: link.href }));
} else {
  const pageModules = import.meta.glob('../pages/*.astro', { eager: true });
  const pages = Object.keys(pageModules).map(path => {
    // Convert file path to URL: ../pages/index.astro -> /
    const url = path
      .replace('../pages/', '/')
      .replace('.astro', '')
      .replace(/\/index$/, '/');
    return { url };
  });
  menuItems = generateMenuItems(pages, additionalLinks);
}

menuItems = shouldShowSitemap()
  ? menuItems
  : menuItems.filter((item) => item.href !== '/sitemap');
---

<div class="menu-bar">
  <menu role="menubar">
            <span class="menu-underline">{link.label.charAt(0)}</span>{link.label.slice(1)}
          </a>
        </li>
      ))
    }
  </menu>
</div>

<script>
  const hasAdminCookie = () => document.cookie.split('; ').some((cookie) => cookie === 'admin=akinevz');

  const hideSitemapLink = () => {
    if (hasAdminCookie()) {
      return;
    }

    document.querySelectorAll('a[href="/sitemap"]').forEach((link) => {
      const menuItem = link.closest('li');
      if (menuItem) {
        menuItem.remove();
      }
    });
  };

  hideSitemapLink();

  document.addEventListener('keydown', (e) => {
    // Don't trigger navigation if user is typing in an input field
    const activeElement = document.activeElement;
    if (
      activeElement &&
      (activeElement.tagName === 'INPUT' ||
       activeElement.tagName === 'TEXTAREA' ||
       activeElement.tagName === 'SELECT' ||
       (activeElement instanceof HTMLElement && activeElement.isContentEditable))
    ) {
      return;
    }

    const key = e.key.toLowerCase();
    const link = document.querySelector(`a[data-key="${key}"]`);
    if (link && link instanceof HTMLAnchorElement) {
      window.location.href = link.href;
    }
  });
</script>
